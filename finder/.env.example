# Copy this file to .env and fill in the values. .env is git-ignored.

# Google Cloud, Places API (New) enabled, billing on.
# Restrict the key to the Places API. Do NOT restrict it by IP — the Signal
# lookup runs on Vercel, whose egress addresses change.
GOOGLE_PLACES_API_KEY=

# Anthropic. Needed by judge-prospects.js and by the Signal lookup.
# Without it the finder and the site audit still run; the judgment does not.
ANTHROPIC_API_KEY=

# The password for the Signal lookup page. Only api/lookup.js reads it.
# Set the same value here and in the Vercel project's environment variables.
LOOKUP_PASSWORD=
