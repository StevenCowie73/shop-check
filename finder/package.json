{
  "name": "shop-check-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Builds a ranked call list of small trade businesses from the Google Places API (New).",
  "main": "find-prospects.js",
  "scripts": {
    "find": "node find-prospects.js",
    "calls": "node make-call-list.js",
    "sites": "node check-sites.js",
    "pilot:walk": "node pilot/1-walk-lslbc.js",
    "pilot:parse": "node pilot/2-parse-records.js",
    "pilot:candidates": "node pilot/3-website-candidates.js",
    "pilot:audit": "SHOP_CHECK_OUT_DIR=pilot/out/audit node check-sites.js",
    "pilot:spine": "node pilot/4-build-spine.js",
    "pilot:shortlist": "node pilot/5-shortlist.js",
    "pilot:email": "node pilot/6-check-email.js",
    "pilot:rules": "node pilot/7-apply-rules.js",
    "pilot:astra": "node pilot/8-astra-websites.mjs",
    "pilot:merge": "node pilot/9-merge-astra.js",
    "pilot:letters": "node pilot/10-render-letters.js",
    "pilot:rebuild": "npm run pilot:spine && npm run pilot:shortlist && npm run pilot:email && npm run pilot:rules && npm run pilot:merge && npm run pilot:letters"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "undici": "^8.11.0"
  }
